{
  "name": "engine-prometheus",
  "version": "1.0.0",
  "description": "Prometheus Engine - Modular Game Engine",
  "type": "module",
  "main": "engine/core/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node scripts/engine-core-self-test.mjs",
    "test:events": "node scripts/events-bus-self-test.mjs 2>/dev/null || echo 'events-bus-self-test not found'",
    "test:game-modules": "node scripts/game-modules-self-test.mjs 2>/dev/null || echo 'game-modules-self-test not found'",
    "test:physics": "node scripts/physics-world-self-test.mjs 2>/dev/null || echo 'physics-world-self-test not found'",
    "test:all": "npm run test && npm run test:events && npm run test:game-modules && npm run test:physics"
  },
  "keywords": [
    "engine",
    "game",
    "3d",
    "webgl",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.3.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  }
}
